# 只绑定本机。凭证只在服务端，勿写入 H5 或提交。
WENXIAN_RUNTIME_DB=var/game.sqlite3
WENXIAN_LIBRARY_URL=http://127.0.0.1:8011
# disabled 为默认；玩家服务只接受 disabled/langchain。离线替身仅供必要单元测试显式注入。
WENXIAN_GATEWAY=disabled
WENXIAN_MODEL=
WENXIAN_MODEL_BASE_URL=
WENXIAN_MODEL_API_KEY=
# 可选，按提供商支持填写；DeepSeek 本轮采用 none 避免思考模式与工具协议冲突。
WENXIAN_MODEL_REASONING_EFFORT=
# DeepSeek 严格工具协议需配 https://api.deepseek.com/beta 和 reasoning_effort=none。
WENXIAN_MODEL_TOOL_PROTOCOL=standard
# 一个回合可能包含多次工具调用；用调用数限制真实请求，默认 0 禁止调用。
WENXIAN_MODEL_CALL_LIMIT=0
