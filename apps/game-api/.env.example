DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
WENXIAN_AI_CONFIG_FORCE_ENVIRONMENT=false
WENXIAN_INVITE_CODE=WENXIAN-LOCAL
WENXIAN_SESSION_DAYS=30
WENXIAN_SECURE_COOKIE=false
WENXIAN_IP_HASH_PEPPER=replace-with-a-long-random-secret
WENXIAN_REGISTRATIONS_PER_IP_PER_DAY=1
WENXIAN_LOGIN_FAILURES_PER_WINDOW=5
WENXIAN_CORS_ALLOWED_ORIGIN_PATTERNS=http://127.0.0.1:*,http://localhost:*,http://192.168.*:*,http://10.*:*,http://172.*:*,http://your-public-host:*
# H5 注册页接入验证码并完成真实邮箱冒烟后才打开；摘要密钥至少使用 32 个随机字符。
WENXIAN_EMAIL_VERIFICATION_ENABLED=false
WENXIAN_EMAIL_VERIFICATION_PEPPER=replace-with-at-least-32-random-characters
WENXIAN_EMAIL_VERIFICATION_EXPIRES_MINUTES=10
WENXIAN_EMAIL_VERIFICATION_RESEND_AFTER_SECONDS=60
WENXIAN_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
WENXIAN_EMAIL_VERIFICATION_MAX_PER_EMAIL_PER_HOUR=5
WENXIAN_EMAIL_VERIFICATION_MAX_PER_IP_PER_HOUR=10
GAME_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/wenxian?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
GAME_DATABASE_USERNAME=wenxian_app
GAME_DATABASE_PASSWORD=replace-with-database-password
GAME_DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# 阿里云邮件推送（DirectMail）。默认关闭；AccessKey 只填写 RAM 子用户 wenxian-mail-sender 的值。
WENXIAN_MAIL_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
WENXIAN_MAIL_ACCOUNT_NAME=no-reply@notice.wenxianlu.cn
WENXIAN_MAIL_FROM_ALIAS=问仙录
WENXIAN_MAIL_ENDPOINT=dm.aliyuncs.com
WENXIAN_MAIL_REGION_ID=cn-hangzhou
WENXIAN_MAIL_CONNECT_TIMEOUT_MILLIS=5000
WENXIAN_MAIL_READ_TIMEOUT_MILLIS=10000

# 命卷迁移中心内部令牌：游戏后端与管理后端必须配置成相同的高强度随机值。
# 留空时迁移中心不可用；不要把真实值提交到仓库。
WENXIAN_MIGRATION_ADMIN_TOKEN=replace-with-a-long-random-migration-secret
WENXIAN_GAME_SERVICE_BASE_URL=http://127.0.0.1:18080
