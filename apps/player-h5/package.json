{
  "name": "h5-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "uv run --locked --project ../game-runtime python ../game-runtime/scripts/run_local_player.py",
    "dev:ui": "vite",
    "dev:creation": "vite --config vite.creation-preview.config.ts",
    "dev:legacy": "vite --config vite.config.ts",
    "test:local": "playwright test --config playwright.local.config.ts",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:creation": "tsc && vite build --config vite.creation-preview.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.87.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
