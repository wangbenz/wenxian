{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "formatVersion", "publisherNamespace", "packageId", "revision",
    "defaultLocale", "name", "summary", "authors", "license", "contentRating",
    "runtimeContract", "requiredCapabilities", "entrypoints", "assets"
  ],
  "properties": {
    "format": {"const": "wenxian.world-package"},
    "formatVersion": {"const": 1},
    "publisherNamespace": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
    "packageId": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
    "revision": {"type": "integer", "minimum": 1},
    "defaultLocale": {"type": "string", "minLength": 1, "maxLength": 24},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "authors": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "license": {"type": "string", "minLength": 1, "maxLength": 80},
    "contentRating": {"enum": ["GENERAL", "TEEN", "MATURE"]},
    "runtimeContract": {"const": "narrative-world-v1"},
    "requiredCapabilities": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "enum": [
          "creation-catalog-v1", "linear-progression-v1", "triggered-lore-v1",
          "player-confirmed-ending-v1"
        ]
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "creation", "progression", "loreIndex"],
      "properties": {
        "world": {"$ref": "./common-v1.schema.json#/$defs/jsonPath"},
        "creation": {"$ref": "./common-v1.schema.json#/$defs/jsonPath"},
        "progression": {"$ref": "./common-v1.schema.json#/$defs/jsonPath"},
        "loreIndex": {"$ref": "./common-v1.schema.json#/$defs/jsonPath"}
      }
    },
    "assets": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "mediaType", "byteSize", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$"},
          "role": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "mediaType": {"enum": ["image/png", "image/jpeg", "image/webp"]},
          "byteSize": {"type": "integer", "minimum": 1, "maximum": 2000000},
          "sha256": {"$ref": "./common-v1.schema.json#/$defs/sha256"}
        }
      }
    }
  }
}
