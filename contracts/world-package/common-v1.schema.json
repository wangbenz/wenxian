{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,79}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "jsonPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
    },
    "bundlePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
