{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["loreId", "title", "content", "priority", "tags", "relatedRefs", "activation"],
        "properties": {
          "loreId": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "content": {"type": "string", "minLength": 1, "maxLength": 4000},
          "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
          "tags": {
            "type": "array", "maxItems": 32, "uniqueItems": true,
            "items": {"$ref": "./common-v1.schema.json#/$defs/tag"}
          },
          "relatedRefs": {
            "type": "array", "uniqueItems": true,
            "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
          },
          "activation": {
            "type": "object", "additionalProperties": false,
            "required": ["always", "identityRefs", "locationRefs", "entityTags", "storyThreadRefs", "terms"],
            "properties": {
              "always": {"type": "boolean"},
              "identityRefs": {
                "type": "array", "uniqueItems": true,
                "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
              },
              "locationRefs": {
                "type": "array", "uniqueItems": true,
                "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
              },
              "entityTags": {
                "type": "array", "maxItems": 32, "uniqueItems": true,
                "items": {"$ref": "./common-v1.schema.json#/$defs/tag"}
              },
              "storyThreadRefs": {
                "type": "array", "uniqueItems": true,
                "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
              },
              "terms": {
                "type": "array", "maxItems": 32, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 80}
              }
            }
          }
        }
      }
    }
  }
}
