{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "playableRaceRefs", "openingRegionRefs", "defaultOpeningRegionRef",
    "requiredOriginFacts", "routeThemes", "scenarioSeeds"
  ],
  "properties": {
    "playableRaceRefs": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
    },
    "openingRegionRefs": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
    },
    "defaultOpeningRegionRef": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
    "requiredOriginFacts": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identityRef", "factType", "semanticRole", "playerLabel"],
        "properties": {
          "identityRef": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "factType": {"enum": ["IDENTITY", "PAST_EVENT", "OBLIGATION", "KNOWLEDGE"]},
          "semanticRole": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "playerLabel": {"type": "string", "minLength": 1, "maxLength": 40}
        }
      }
    },
    "routeThemes": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["themeId", "summary", "loreRefs"],
        "properties": {
          "themeId": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "loreRefs": {
            "type": "array", "uniqueItems": true,
            "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
          }
        }
      }
    },
    "scenarioSeeds": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["seedId", "eligibleRegionRefs", "tags", "summary"],
        "properties": {
          "seedId": {"$ref": "./common-v1.schema.json#/$defs/stableId"},
          "eligibleRegionRefs": {
            "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
            "items": {"$ref": "./common-v1.schema.json#/$defs/stableId"}
          },
          "tags": {
            "type": "array", "maxItems": 32, "uniqueItems": true,
            "items": {"$ref": "./common-v1.schema.json#/$defs/tag"}
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
