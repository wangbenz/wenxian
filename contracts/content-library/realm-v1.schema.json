{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/contracts/content-library/realm-v1.schema.json",
  "title": "问仙录境界定义 v1",
  "type": "object",
  "allOf": [{ "$ref": "common-v1.schema.json#/$defs/commonFields" }],
  "required": ["order", "detail", "stages", "lifespan_years", "can", "cannot"],
  "properties": {
    "key": true, "name": true, "aliases": true, "description": true, "usage": true,
    "limitations": true, "source": true, "revision": true, "content_hash": true,
    "order": { "type": "integer", "minimum": 0, "description": "大境界顺序：凡人 0，炼气 1……服务端用于比较强弱" },
    "detail": { "type": "string", "enum": ["full", "placeholder"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": { "$ref": "common-v1.schema.json#/$defs/key" },
          "name": { "$ref": "common-v1.schema.json#/$defs/shortText" }
        },
        "additionalProperties": false
      }
    },
    "lifespan_years": { "type": "integer", "minimum": 1, "description": "参考寿元（岁）" },
    "can": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/text" }, "maxItems": 12 },
    "cannot": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/text" }, "maxItems": 12 },
    "breakthrough": {
      "type": "object",
      "required": ["requires", "risk"],
      "properties": {
        "requires": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/text" }, "minItems": 1 },
        "aids": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/key" }, "description": "辅助物品 key" },
        "risk": { "$ref": "common-v1.schema.json#/$defs/text" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "if": { "properties": { "detail": { "const": "full" } } },
  "then": { "properties": { "can": { "minItems": 1 }, "cannot": { "minItems": 1 } } }
}
